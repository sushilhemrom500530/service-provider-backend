# Server
NODE_ENV=development
PORT=5000
SOCKET_PORT=5001

# Database
MONGO_URI= your_mongo_uri

# JWT
JWT_ACCESS_KEY=your_demo_jwt_access_key
JWT_REFRESH_KEY=your_demo_jwt_refresh_key
JWT_ACCESS_EXPIRES=365d
JWT_REFRESH_EXPIRES=365d

# AWS S3
AWS_S3_KEY=your_aws_access_key
AWS_S3_SECRET=your_aws_secret
AWS_REGION=us-east-1
AWS_S3_BUCKET=your_aws_s3_bucket

# Email / SMTP
SMTP_EMAIL=your_smtp_email
SMTP_PASSWORD=your_smtp_password
SMTP_HOST=smtp.example.com
SMTP_PORT=587
EMAIL_FROM=your_email

# Security
BCRYPT_SALT_ROUNDS=10
MAX_LOGIN_ATTEMPTS=5
LOCK_TIME_HOURS=2

# Application / Paths
USER_UPLOADS_FOLDER=uploads/users
USER_UPLOAD_S3_FOLDER=users

# CORS / Networking
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
BACKEND_IP=127.0.0.1


# client url 
CLIENT_URL=http://localhost:3000


# admin payment profit 
ADMIN_PAYMENT_PROFIT=20


 # Stripe Configuration
STRIPE_SECRET_KEY=YOUR_STRIPE_SECRET_KEY
STRIPE_WEBHOOK_SECRET=YOUR_STRIPE_WEBHOOK_SECRET
STRIPE_PUBLISHABLE_KEY=YOUR_STRIPE_PUBLISHABLE_KEY
STRIPE_CURRENCY=eur
